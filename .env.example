# Copy to .env.local for local dev; set the same vars in Vercel project settings
# for production. The public site builds and runs without any of them; the
# owner's /admin tool needs the four ADMIN-section vars below.

# Public base URL of the deployed site (used for metadata, OG, sitemap, robots).
# e.g. https://your-domain.com — falls back to the placeholder in data/site.ts.
NEXT_PUBLIC_SITE_URL=

# Web3Forms access key for the contact form. This key is PUBLIC by design (it is
# submitted from the browser), so it is safe to expose. Get a free key at
# https://web3forms.com (enter your email, verify it). Without this, the contact
# form falls back to opening a pre-filled mailto: link instead of sending.
NEXT_PUBLIC_WEB3FORMS_KEY=

# --- ADMIN (server-only secrets; never prefix with NEXT_PUBLIC_) ---
# Signs the owner's session cookie. 32+ random chars, e.g. `openssl rand -base64 48`.
# Rotating it signs the owner out.
AUTH_SECRET=
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID, type "Web application"). Authorized redirect URI:
# <NEXT_PUBLIC_SITE_URL>/admin/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google accounts allowed into /admin.
ADMIN_EMAILS=
